# Copy this file to .env and fill in real values. .env is git-ignored. Never commit credentials.

# Application under test (required). Used by the e2e suite and the discovery framework.
BIZOM_BASE_URL=https://devarun.bizomdev.in
# Admin credentials. Without them automated login is disabled; discovery can still log in
# manually with HEADLESS=false.
BIZOM_USERNAME=
BIZOM_PASSWORD=

# Discovery framework: browser and login (everything else is in config/discovery-config.json).
# HEADLESS=false opens a visible browser, needed for manual login and MFA. Default: browser.headless.
HEADLESS=true
# Login timeout in milliseconds. Default: authentication.loginTimeoutMs.
LOGIN_TIMEOUT=60000

# Login page path for the e2e suite (discovery uses authentication.loginRoute).
LOGIN_PATH=/users/login

# Password the sales test sets for the distributor manager it picks.
DM_NEW_PASSWORD=Web@123123

# Distributor manager account for role-based UI tests (its password is DM_NEW_PASSWORD).
DM_USERNAME=pricing.distributor

# Automation users (usernames starting with e2e., see data/automationUsers.ts).
# Their passwords are this prefix + digits, new on every run (the app refuses a user's last 3 passwords).
E2E_USER_PASSWORD_PREFIX=Web@

# User block tests (npm run test:user-block): how many wrong passwords to try, 2 to 9. Default 9.
# The run waits that many minutes for the block to end, so a smaller number is faster but covers less.
# USER_BLOCK_ATTEMPTS=9
