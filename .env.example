# Copy this file to .env and fill in real values. .env is git-ignored.
BASE_URL=https://devarun.bizomdev.in
LOGIN_PATH=/users/login
BIZOM_USERNAME=
BIZOM_PASSWORD=

# Password the sales test sets for the distributor manager it picks.
DM_NEW_PASSWORD=Web@123123

# Distributor manager account for role-based UI tests (its password is DM_NEW_PASSWORD).
DM_USERNAME=pricing.distributor

# Automation users (usernames starting with e2e., see data/automationUsers.ts).
# Their passwords are this prefix + digits, new on every run (the app refuses a user's last 3 passwords).
E2E_USER_PASSWORD_PREFIX=Web@
