{
  "name": "bizom-e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/auth --headed",
    "test:ui": "playwright test --ui",
    "spec:check": "node scripts/spec-check.mjs",
    "coverage:users": "node --disable-warning=ExperimentalWarning scripts/user-coverage.mjs",
    "test:users": "playwright test tests/users --headed",
    "test:users:config": "E2E_CONFIG=1 playwright test --project=config tests/users/config",
    "test:user-creation": "playwright test tests/user-creation",
    "test:user-creation:config": "E2E_CONFIG=1 playwright test --project=config tests/user-creation/config",
    "test:admin": "playwright test tests/admin --headed",
    "test:sales": "playwright test tests/sales --headed",
    "test:roles": "playwright test tests/roles --headed",
    "test:config": "E2E_CONFIG=1 playwright test --project=config",
    "test:user-block": "E2E_USER_BLOCK=1 playwright test --project=user-block",
    "cleanup:e2e-users": "E2E_CLEANUP=1 playwright test tests/maintenance --reporter=list",
    "report": "playwright show-report",
    "discovery:validate": "E2E_DISCOVERY=1 playwright test --project=discovery tests/discovery/config-validation.spec.ts --reporter=list",
    "discovery:auth-nav": "E2E_DISCOVERY=1 playwright test --project=discovery tests/discovery/auth-navigation.spec.ts --reporter=list",
    "discovery:test": "E2E_DISCOVERY=1 playwright test --project=discovery --reporter=list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0"
  }
}
